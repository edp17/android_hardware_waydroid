// HAL module implemenation stored in
// hw/<OVERLAY_HARDWARE_MODULE_ID>.<ro.product.board>.so
cc_library_shared {
    name: "hwcomposer.waydroid",
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libsync",
        "libui",
        "libdrm",
        "libEGL",
        "libGLESv2",
        "vendor.waydroid.clipboard@1.0",
        "vendor.waydroid.display@1.0",
        "vendor.waydroid.display@1.1",
        "vendor.waydroid.display@1.2",
        "vendor.waydroid.task@1.0",
        "vendor.waydroid.window@1.0",
        "vendor.waydroid.window@1.1",
        "vendor.waydroid.window@1.2",
    ],
    static_libs: [
        "libwayland_client",
        "libffi",
        "libwayland_extension_client_protocols",
        "libxkbcommon",
    ],
    srcs: [
        "extension.cpp",
        "hwcomposer.cpp",
        "sw_sync_compat.cpp",
        "wayland-hwc.cpp",
        "WaydroidClipboard.cpp",
        "WaydroidWindow.cpp",
        "egl-tools.cpp",
    ],
    header_libs: [
        "libsystem_headers",
        "minigbm_headers",
    ],
    include_dirs: [
        "system/core",
        "system/core/libsync",
        "system/core/libsync/include"
    ],
    cflags: [
        "-DLOG_TAG=\"hwcomposer\"",
        "-Wall",
        "-Werror",
    ],
    generated_sources: [
        "wayland_android_client_protocol_sources",
        "waydroid_xdg_shell_client_protocol_sources",
        "waydroid_fractional_scale_client_protocol_sources",
    ],
    generated_headers: [
        "wayland_android_client_protocol_headers",
        "waydroid_xdg_shell_client_protocol_headers",
        "waydroid_fractional_scale_client_protocol_headers",
    ],
}

// Generate wayland-android protocol source file
genrule {
    name: "wayland_android_client_protocol_sources",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["wayland-android-client-protocol.c"],
}
// Generate wayland-android protocol header file
genrule {
    name: "wayland_android_client_protocol_headers",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["wayland-android-client-protocol.h"],
}

// Generate stable xdg-shell protocol source/header.
// The Android 11 external/wayland-protocols tree used here only exports
// xdg-shell unstable v5/v6 headers, while hwcomposer uses stable xdg_wm_base.
genrule {
    name: "waydroid_xdg_shell_client_protocol_sources",
    srcs: ["protocols/xdg-shell.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["xdg-shell-client-protocol.c"],
}

genrule {
    name: "waydroid_xdg_shell_client_protocol_headers",
    srcs: ["protocols/xdg-shell.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["xdg-shell-client-protocol.h"],
}

// Generate fractional-scale protocol source/header.
// hwcomposer includes fractional-scale-v1-client-protocol.h directly.
genrule {
    name: "waydroid_fractional_scale_client_protocol_sources",
    srcs: ["protocols/fractional-scale-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["fractional-scale-v1-client-protocol.c"],
}

genrule {
    name: "waydroid_fractional_scale_client_protocol_headers",
    srcs: ["protocols/fractional-scale-v1.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["fractional-scale-v1-client-protocol.h"],
}

